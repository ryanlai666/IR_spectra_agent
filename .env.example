# Copy to .env (never commit .env) or export these in your shell.
# Only needed for the LLM planner/analyst. `ir-agent run --no-llm --plan plan.json` needs no key.
GOOGLE_API_KEY=

# Optional: override the Gemini model from configs/default.yaml
# IR_AGENT_LLM_MODEL=gemini-3.8-flash

# Optional: Hugging Face token for the gated UMA checkpoints (facebook/UMA).
# Prefer `hf auth login`, which stores the token outside the repo.
# HF_TOKEN=

# Optional: path to the xtb executable (GFN2-xTB). Auto-detected on PATH and in ./.tools/xtb.
# IR_AGENT_XTB_BIN=

# Optional: legacy DFT/DFTB presets
# DFTB_PREFIX=/path/to/slako/files/
# VASP_COMMAND=mpirun vasp_std
# VASP_PP_PATH=/path/to/potpaw
